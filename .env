# CDN Configuration
# Required: CDN provider strategy
CDN_STRATEGY=r2
# Required: Base URL for your CDN
CDN_BASE_URL=https://cdn.questflow.ai

# AWS S3 / Cloudflare R2 Configuration
AWS_S3_BUCKET=cdn
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=8fc16dbcc9e11b1ee7716bf14e6db105
AWS_SECRET_ACCESS_KEY=bb032fc4d34052e0e2dbc1e6b41306915e3d7c139e8537d6a56bed63b67515ab

# For Cloudflare R2 (uncomment if using R2)
S3_ENDPOINT=https://2766e3e3366bfad08de5b14f999d74de.r2.cloudflarestorage.com
S3_FORCE_PATH_STYLE=true
AWS_REGION=auto

# Google Cloud Storage Configuration (alternative to AWS S3)
# GCS_BUCKET=your-gcs-bucket-name
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_PROJECT_ID=your-project-id

# Or use inline JSON credentials for GCS
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
